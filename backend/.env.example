# Copy to backend/.env.local, or run `npm run setup` to create it with fresh Nile test wallets.
# Nile testnet keys only. Never commit real keys.

# Wallets (npm run setup generates these)
PAYER_PRIVATE_KEY=        # signs GasFree permits; its GasFree address needs Nile USDT
OWNER_PRIVATE_KEY=        # optional: signs the policy when TronLink is not used
NOTARY_PRIVATE_KEY=       # deploys and writes the registry contract; needs Nile TRX

# GasFree (apply at https://developer.gasfree.io/ or ask the TRON booth)
GASFREE_BASE=https://open-test.gasfree.io/nile/
GASFREE_API_KEY=
GASFREE_API_SECRET=

# TRON
TRON_FULLHOST=https://nile.trongrid.io
TRONGRID_API_KEY=         # optional: avoids rate limits on the mainnet freeze-list check

# Kiln (FuriosaAI developer kit). Any OpenAI-compatible API works, for example OpenRouter:
# KILN_BASE_URL=https://openrouter.ai/api/v1  KILN_MODEL=openai/gpt-oss-120b
KILN_BASE_URL=
KILN_API_KEY=
KILN_MODEL=gpt-oss-120b

# Screening rules
CONTACT_WAIT_HOURS=3      # new contacts wait this long before they can be paid (like 지연이체); 0 turns it off
TRAVEL_RULE_KRW=1000000   # Korea's Travel Rule threshold; lower it to show the check with small demo amounts
KRW_PER_USDT=1400         # rate used to turn the threshold into USDT

# Telegram alerts (optional): create a bot with @BotFather. TELEGRAM_CHAT_ID is one owner chat; more owners
# connect with the console's Connect my Telegram, and families from their receipt page. Those need the webhook,
# which is registered at startup when PUBLIC_API_URL is set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_API_URL=           # the backend's public address, for Telegram's webhook
PUBLIC_SITE_URL=          # the console's public address, for receipt links in family messages

# Demo only: drop the GasFree response for this spreadsheet line once, to show recovery
SIMULATE_LOST_RESPONSE_LINE=

# Public deployment only: every request must carry this key (the frontend proxy adds it)
BACKEND_KEY=
